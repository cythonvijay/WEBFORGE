# Local development defaults. Set JWT_SECRET before using authenticated routes.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
ENABLE_METRICS=true

# Use SQLite for quick local development. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./webforge.db
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Server-side Google Gemini configuration; never expose this key to the frontend.
AI_PROVIDER=google
GOOGLE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_TIMEOUT_SECONDS=60

# Docker Compose PostgreSQL settings (keep these placeholders out of production).
POSTGRES_USER=webforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=webforge
POSTGRES_PORT=5432
